.venv/
.venv_broken/
# 各 GPU 变体用的独立虚拟环境（实测本机存在 .venv-dml/）：漏掉它会被
# 一次 `git add -A` 整个写进仓库
.venv-*/
__pycache__/
# ruff 的缓存目录（跑 `ruff check` 会生成）
.ruff_cache/
*.pyc
*.pyo
*.egg-info/
tests/_tmp/
wheels/
# 模型为二进制大文件，不入库：手动从 resources/PP-OCRv6_models_manifest.txt 的 ModelScope 链接下载
resources/models/
# v6 medium/small 大模型（共 162MB）同样不入库；下载地址与 sha256 见同一份 manifest
resources/models_v6/*_medium.onnx
resources/models_v6/*_small.onnx
# 构建产物 / 运行数据（不入库）
build/
dist/
logs/
*.db
# SQLite 的 WAL 旁挂文件：库名是 *.db 但它们是 *.db-wal / *.db-shm，
# 只写 *.db 挡不住（实测它们会出现在 git status 里）
*.db-wal
*.db-shm
*.db-journal
*.db.bak*
screenshots/
screenshots_*/
# 运行期用户配置：dev 在仓库根、打包在 exe 同目录，首次运行由 resources/config.ini
# （出厂模板，只读）复制生成。属「本机状态」不入库，否则个人/机器相关项会随克隆扩散
config.ini

# scripts/ 下脚本**自己生成**的图片（基准/诊断脚本的产物），属运行产物不入库；
# 守卫基线（_p0_baseline_*.qss / _slot_snapshot.json）恰好相反，是冻结参照，必须入库
scripts/_*.png

# 项目状态数据（记忆/会话等，不入库）
.workbuddy/

# 历史归档与落地页：本地保留（冻结溯源），不入库
docs/archive/
/index.html
